{
  "name": "azeroth-guild-template",
  "version": "1.0.0",
  "private": true,
  "description": "Free static website template for World of Warcraft: Forever guilds, built with Astro and Tailwind CSS.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:config": "node scripts/check-config.mjs",
    "check:content": "node scripts/validate-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test",
    "verify": "npm run check:config && npm run check:content && npm run check && npm run test && npm run build && npm run check:links"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3"
  }
}
