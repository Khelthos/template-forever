---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { href } from "../lib/paths.js";
import { formatDate, t } from "../lib/navigation.js";

interface Props {
  entry: CollectionEntry<"news">;
  headingLevel?: 2 | 3;
}

const { entry, headingLevel = 3 } = Astro.props;
const { data } = entry;
const H = headingLevel === 2 ? "h2" : "h3";
---

<article class="panel lift group relative flex flex-col overflow-hidden">
  {
    data.cover && (
      <img
        src={href(data.cover)}
        alt={data.coverAlt}
        width="640"
        height="320"
        loading="lazy"
        decoding="async"
        class="aspect-[2/1] w-full rounded-t-lg object-cover"
      />
    )
  }
  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2 text-sm text-muted">
      {data.category && <span class="chip">{data.category}</span>}
      {data.example && <span class="chip">{t("demo.notice")}</span>}
      <span class="inline-flex items-center gap-1.5">
        <Icon name="calendar" size={16} />
        <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
      </span>
    </div>
    <H class="mt-3 text-xl">
      <a href={href(`/news/${entry.id}/`)} class="text-text no-underline after:absolute after:inset-0 group-hover:text-accent">
        {data.title}
      </a>
    </H>
    <p class="mt-2 flex-1 text-muted">{data.description}</p>
    {data.author && <p class="mt-4 text-sm text-muted">{t("article.by")} {data.author}</p>}
  </div>
</article>
