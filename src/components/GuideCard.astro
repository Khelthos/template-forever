---
import type { CollectionEntry } from "astro:content";
import Icon from "./Icon.astro";
import { href } from "../lib/paths.js";
import { config } from "../lib/site-config.js";
import { formatDate, t } from "../lib/navigation.js";

interface Props {
  entry: CollectionEntry<"guides">;
  headingLevel?: 2 | 3;
}

const { entry, headingLevel = 3 } = Astro.props;
const { data } = entry;
const H = headingLevel === 2 ? "h2" : "h3";
const category = config.guides.categories.find((c) => c.id === data.type);
const typeIcon: Record<string, string> = { dungeon: "castle", raid: "dps", class: "user", spec: "mage", group: "tank" };
---

<article class:list={["panel lift group relative flex flex-col p-5", data.featured && "panel-ornate"]}>
  <div class="flex items-start gap-4">
    <span class="flex size-12 shrink-0 items-center justify-center rounded-md border border-border bg-surface-2 text-accent">
      <Icon name={typeIcon[data.type] ?? "scroll"} size={24} />
    </span>
    <div class="min-w-0">
      <div class="flex flex-wrap gap-2 text-sm">
        {category && <span class="chip">{category.label}</span>}
        {data.difficulty && <span class="chip">{t("guides.difficulty")}: {t(`difficulty.${data.difficulty}`)}</span>}
        {data.featured && <span class="chip">★ {t("guides.featured")}</span>}
        {data.example && <span class="chip">{t("demo.notice")}</span>}
      </div>
      <H class="mt-2 text-xl">
        <a href={href(`/guides/${entry.id}/`)} class="text-text no-underline after:absolute after:inset-0 group-hover:text-accent">
          {data.title}
        </a>
      </H>
    </div>
  </div>
  <p class="mt-3 flex-1 text-muted">{data.description}</p>
  <p class="mt-4 text-sm text-muted">
    <time datetime={data.pubDate.toISOString()}>{formatDate(data.pubDate)}</time>
    {data.author && <> · {t("article.by")} {data.author}</>}
  </p>
</article>
