---
// Original hero illustration as inline SVG: it takes the colors of the active
// palette and changes architecture with the faction. Used when
// appearance.backgroundImage is empty.
//
// Layered so it stays proportional at every width:
// sky (CSS, full width) → central scene (fixed 2:1 ratio, as tall as the
// hero) → foreground ground (stretches to full width).
import { config } from "../lib/site-config.js";

const faction = config.guild.faction;
// Stars at fixed positions (no randomness: identical output on every build).
const stars = [
  [120, 80, 1.6], [260, 150, 1.1], [340, 60, 1.4], [480, 120, 1], [610, 50, 1.8], [700, 170, 1.2],
  [820, 90, 1], [980, 40, 1.5], [1060, 140, 1.1], [1180, 70, 1.7], [1300, 160, 1], [1420, 60, 1.3],
  [1520, 130, 1.1], [90, 210, 1], [560, 230, 1.2], [1250, 240, 1], [1480, 250, 1.4], [400, 260, 1],
];
---

<div class="hero-art absolute inset-0 overflow-hidden" aria-hidden="true">
  <svg class="hero-scene" viewBox="0 0 1600 800" preserveAspectRatio="xMidYMax meet" focusable="false">
    <defs>
      <radialGradient id="hero-glow" cx="0.5" cy="0.5" r="0.5">
        <stop offset="0" class="s-glow" stop-opacity="0.55" />
        <stop offset="1" class="s-glow" stop-opacity="0" />
      </radialGradient>
    </defs>

    <circle cx="1210" cy="190" r="260" fill="url(#hero-glow)" />
    <circle cx="1210" cy="190" r="62" class="f-moon" />
    {stars.map(([x, y, r]) => <circle cx={x} cy={y} r={r} class="f-star" />)}

    <!-- Distant mountains and hills: at the edges they drop below the ground -->
    <path class="f-far" d="M0 720 L60 560 L140 420 L260 480 L420 340 L560 455 L700 365 L860 470 L1010 345 L1160 455 L1300 385 L1460 480 L1540 560 L1600 720 V800 H0Z" />
    <path class="f-mid" d="M0 720 C120 620 300 565 460 595 C640 625 760 545 940 565 C1120 585 1300 540 1480 600 C1540 625 1580 670 1600 720 V800 H0Z" />

    {
      faction === "horde" ? (
        <g class="f-structure">
          {/* Fortress with spiked towers and palisade */}
          <path d="M300 640 V470 L330 430 L360 470 V640Z" />
          <path d="M350 640 V500 H520 V640Z" />
          <path d="M500 640 V440 L540 380 L580 440 V640Z" />
          <path d="M330 430 L320 400 M540 380 L540 340 M575 445 L600 415 M505 445 L480 415" class="s-spike" />
          {[380, 410, 440, 470].map((x) => <path d={`M${x} 500 L${x + 12} 470 L${x + 24} 500Z`} />)}
          {/* Tents */}
          <path d="M640 640 L700 540 L760 640Z" />
          <path d="M740 640 L790 560 L840 640Z" />
          <path d="M700 540 V515 M790 560 V535" class="s-spike" />
          {/* Banners */}
          <path d="M540 340 H585 L572 356 L585 372 H540Z" class="f-banner" />
          <path d="M700 515 H730 L720 525 L730 535 H700Z" class="f-banner" />
        </g>
      ) : (
        <g class="f-structure">
          {/* Castle with spires */}
          <path d="M300 640 V450 H340 V640Z" />
          <path d="M296 450 L320 380 L344 450Z" />
          <path d="M340 640 V490 H560 V640Z" />
          {[340, 380, 420, 460, 500, 540].map((x) => <rect x={x} y="476" width="20" height="16" />)}
          <path d="M410 640 V400 H490 V640Z" />
          <path d="M404 400 L450 300 L496 400Z" />
          <path d="M560 640 V440 H600 V640Z" />
          <path d="M556 440 L580 370 L604 440Z" />
          <path d="M430 640 V560 A20 20 0 0 1 470 560 V640Z" class="f-gate" />
          {[425, 465].map((x) => <rect x={x} y="420" width="10" height="22" rx="5" class="f-window" />)}
          {/* Banners */}
          <path d="M450 300 V262" class="s-spike" />
          <path d="M450 262 H492 V290 L471 280 L450 290Z" class="f-banner" />
          <path d="M320 380 V356 M580 370 V346" class="s-spike" />
          <path d="M320 356 H344 L336 364 L344 372 H320Z" class="f-banner" />
          <path d="M580 346 H604 L596 354 L604 362 H580Z" class="f-banner" />
        </g>
      )
    }
  </svg>

  <!-- Foreground: stretches across the full width of the hero -->
  <svg class="hero-ground" viewBox="0 0 1600 800" preserveAspectRatio="none" focusable="false">
    <path class="f-near" d="M0 660 C200 625 380 645 560 652 C760 662 900 632 1100 638 C1300 644 1450 622 1600 632 V800 H0Z" />
    <path class="f-ground" d="M0 720 C260 700 520 712 800 708 C1080 704 1340 698 1600 704 V800 H0Z" />
  </svg>
</div>

<style>
  /* Sky with a glow on the horizon so the dark silhouettes stand out. */
  .hero-art {
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--c-hero-to) 60%, var(--c-hero-from)) 0%,
      var(--c-hero-from) 45%,
      color-mix(in srgb, var(--c-hero-from) 78%, var(--c-hero-accent)) 72%,
      var(--c-hero-to) 92%
    );
  }
  .hero-scene,
  .hero-ground {
    position: absolute;
    bottom: 0;
    height: 100%;
  }
  /* Centered scene with a fixed ratio: cropped at the sides on narrow screens,
     kept at the right size on very wide screens. */
  .hero-scene {
    left: 50%;
    width: auto;
    aspect-ratio: 2 / 1;
    max-width: none;
    transform: translateX(-50%);
  }
  .hero-ground {
    left: 0;
    width: 100%;
  }
  .hero-art .s-glow { stop-color: var(--c-hero-accent); }
  .hero-art .f-moon { fill: color-mix(in srgb, var(--c-hero-accent) 55%, white); opacity: 0.9; }
  .hero-art .f-star { fill: var(--c-hero-text); opacity: 0.55; }
  .hero-art .f-far { fill: color-mix(in srgb, var(--c-hero-from) 75%, var(--c-hero-accent)); opacity: 0.5; }
  .hero-art .f-mid { fill: color-mix(in srgb, var(--c-hero-to) 65%, var(--c-hero-from)); }
  .hero-art .f-structure { fill: color-mix(in srgb, var(--c-hero-to) 70%, black); }
  .hero-art .s-spike { fill: none; stroke: color-mix(in srgb, var(--c-hero-to) 70%, black); stroke-width: 5; stroke-linecap: round; }
  .hero-art .f-banner { fill: var(--c-primary); stroke: var(--c-hero-accent); stroke-width: 2; }
  .hero-art .f-gate { fill: color-mix(in srgb, var(--c-hero-accent) 30%, black); }
  .hero-art .f-window { fill: var(--c-hero-accent); opacity: 0.8; }
  .hero-art .f-near { fill: color-mix(in srgb, var(--c-hero-to) 90%, black); }
  .hero-art .f-ground { fill: color-mix(in srgb, var(--c-hero-to) 70%, black); }
</style>
