---
// Guild presentation: text from src/content/pages/about.md,
// activities, recruitment and contacts from site.config.mjs.
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import RecruitmentStatus from "../components/RecruitmentStatus.astro";
import FactionEmblem from "../components/FactionEmblem.astro";
import Icon from "../components/Icon.astro";
import { config } from "../lib/site-config.js";
import { socialLinks, t } from "../lib/navigation.js";

const { site, guild, features } = config;
const page = await getEntry("pages", "about");
const rendered = page ? await render(page) : null;
const socials = socialLinks();
const icons: Record<string, string> = { discord: "chat", website: "globe", youtube: "play", twitch: "stream" };
const title = page?.data.title ?? t("nav.about");
---

<BaseLayout title={title} description={page?.data.description || site.description}>
  <section class="relative overflow-hidden border-b border-border bg-[var(--c-hero-to)]">
    <div class="container-page py-14 lg:py-20">
      <FactionEmblem />
      <h1 class="mt-4 text-hero-text">{title}</h1>
      {guild.description && <p class="mt-4 max-w-2xl text-lg text-hero-text/90">{guild.description}</p>}
    </div>
  </section>

  <div class="container-page grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_22rem] lg:py-16">
    <div>
      {rendered && <div class="prose"><rendered.Content /></div>}

      {
        guild.activities.length > 0 && (
          <section class="mt-14" aria-labelledby="activities">
            <SectionHeading id="activities" title={t("home.activities")} />
            <ul class="grid gap-4 sm:grid-cols-2">
              {guild.activities.map((a) => (
                <li class="panel p-5">
                  <h3 class="text-lg text-text">{a.title}</h3>
                  {a.description && <p class="mt-1 text-muted">{a.description}</p>}
                  {a.schedule && (
                    <p class="mt-3 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                      <Icon name="calendar" size={16} />
                      {a.schedule}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        guild.goals.length > 0 && (
          <section class="mt-14" aria-labelledby="goals">
            <SectionHeading id="goals" title={t("home.goals")} />
            <ul class="space-y-2">
              {guild.goals.map((g) => (
                <li class="flex gap-3">
                  <span class="mt-2.5 block size-2 shrink-0 rotate-45 bg-ornament" aria-hidden="true" />
                  <span>{g}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="space-y-6">
      {features.recruitment && <RecruitmentStatus />}

      <section id="contacts" class="panel p-6" aria-labelledby="contacts-title">
        <h2 id="contacts-title" class="text-2xl text-accent">{t("about.contacts")}</h2>
        {
          socials.length ? (
            <ul class="mt-4 space-y-2">
              {socials.map((s) => (
                <li>
                  <a href={s.url} class="btn btn-ghost w-full justify-start" rel="noopener noreferrer" target="_blank">
                    <Icon name={icons[s.key]} size={18} />
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-muted">{t("recruitment.noContact")}</p>
          )
        }
        <dl class="mt-6 space-y-2 text-sm">
          {guild.server && (
            <div class="flex justify-between gap-4 border-b border-border pb-2">
              <dt class="text-muted">{t("info.server")}</dt>
              <dd class="font-semibold">{guild.server}</dd>
            </div>
          )}
          {guild.region && (
            <div class="flex justify-between gap-4 border-b border-border pb-2">
              <dt class="text-muted">{t("info.region")}</dt>
              <dd class="font-semibold">{guild.region}</dd>
            </div>
          )}
          {guild.founded && (
            <div class="flex justify-between gap-4">
              <dt class="text-muted">{t("info.founded")}</dt>
              <dd class="font-semibold">{guild.founded}</dd>
            </div>
          )}
        </dl>
      </section>
    </aside>
  </div>
</BaseLayout>
