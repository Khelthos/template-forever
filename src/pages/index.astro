---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import NewsCard from "../components/NewsCard.astro";
import GuideCard from "../components/GuideCard.astro";
import MemberCard from "../components/MemberCard.astro";
import RecruitmentStatus from "../components/RecruitmentStatus.astro";
import Icon from "../components/Icon.astro";
import { config } from "../lib/site-config.js";
import { getPublished } from "../lib/content.js";
import { getRoster } from "../lib/roster-data.js";
import { roleCounts } from "../lib/roster.js";
import { href } from "../lib/paths.js";
import { t } from "../lib/navigation.js";

const { guild, features } = config;
const news = features.news ? (await getPublished("news")).slice(0, 3) : [];
const allGuides = features.guides ? await getPublished("guides") : [];
const guides = [...allGuides.filter((g) => g.data.featured), ...allGuides.filter((g) => !g.data.featured)].slice(0, 3);
const members = features.roster ? getRoster() : [];
const active = members.filter((m) => m.active);
const counts = roleCounts(members);
const highlighted = [...active].sort((a, b) => a.rankOrder - b.rankOrder).slice(0, 3);

const facts = [
  guild.server && { label: t("info.server"), value: guild.server },
  guild.region && { label: t("info.region"), value: guild.region },
  guild.founded && { label: t("info.founded"), value: guild.founded },
  features.roster && { label: t("info.members"), value: String(active.length) },
].filter(Boolean) as { label: string; value: string }[];
---

<BaseLayout>
  <Hero />

  {
    facts.length > 0 && (
      <section aria-label={t("home.about")} class="border-b border-border bg-surface">
        <dl class="container-page grid grid-cols-2 gap-4 py-5 text-center sm:grid-cols-4">
          {facts.map((f) => (
            <div>
              <dt class="text-xs font-semibold uppercase tracking-widest text-muted">{f.label}</dt>
              <dd class="font-display mt-1 text-lg text-accent">{f.value}</dd>
            </div>
          ))}
        </dl>
      </section>
    )
  }

  <section class="container-page py-14 lg:py-20" aria-labelledby="about-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)]">
      <div>
        <SectionHeading id="about-title" title={t("home.about")} link={{ href: href("/about/"), label: t("cta.discover") }} />
        {guild.description && <p class="max-w-2xl text-lg">{guild.description}</p>}
        {
          guild.goals.length > 0 && (
            <>
              <h3 class="mt-8 text-accent">{t("home.goals")}</h3>
              <ul class="mt-3 space-y-2">
                {guild.goals.map((g) => (
                  <li class="flex gap-3">
                    <span class="mt-2.5 block size-2 shrink-0 rotate-45 bg-ornament" aria-hidden="true" />
                    <span>{g}</span>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
      {features.recruitment && <RecruitmentStatus headingLevel={3} />}
    </div>
  </section>

  {
    guild.activities.length > 0 && (
      <section class="border-y border-border bg-surface/60 py-14 lg:py-20" aria-labelledby="activities-title">
        <div class="container-page">
          <SectionHeading id="activities-title" title={t("home.activities")} />
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {guild.activities.map((a) => (
              <li class="panel panel-ornate p-6">
                <h3 class="text-xl text-text">{a.title}</h3>
                {a.description && <p class="mt-2 text-muted">{a.description}</p>}
                {a.schedule && (
                  <p class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-accent">
                    <Icon name="calendar" size={16} />
                    {a.schedule}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    features.news && (
      <section class="container-page py-14 lg:py-20" aria-labelledby="news-title">
        <SectionHeading
          id="news-title"
          title={t("home.latestNews")}
          link={news.length ? { href: href("/news/"), label: t("home.allNews") } : undefined}
        />
        {news.length ? (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {news.map((entry) => (
              <NewsCard entry={entry} />
            ))}
          </div>
        ) : (
          <p class="text-muted">{t("news.empty")}</p>
        )}
      </section>
    )
  }

  {
    features.roster && (
      <section class="border-y border-border bg-surface/60 py-14 lg:py-20" aria-labelledby="roster-title">
        <div class="container-page">
          <SectionHeading
            id="roster-title"
            title={t("home.roster")}
            intro={t("home.rosterIntro")}
            link={{ href: href("/roster/"), label: t("home.rosterLink") }}
          />
          <ul class="mb-8 grid grid-cols-3 gap-3 sm:max-w-xl">
            {(["tank", "healer", "dps"] as const).map((role) => (
              <li class="panel flex flex-col items-center gap-1 p-4 text-center">
                <Icon name={role} size={26} class="text-accent" />
                <span class="font-display text-2xl text-text">{counts[role]}</span>
                <span class="text-sm text-muted">{t(`role.${role}`)}</span>
              </li>
            ))}
          </ul>
          {highlighted.length > 0 && (
            <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {highlighted.map((m) => (
                <MemberCard member={m} compact />
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }

  {
    features.guides && (
      <section class="container-page py-14 lg:py-20" aria-labelledby="guides-title">
        <SectionHeading
          id="guides-title"
          title={t("home.guides")}
          intro={t("home.guidesIntro")}
          link={guides.length ? { href: href("/guides/"), label: t("home.allGuides") } : undefined}
        />
        {guides.length ? (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {guides.map((entry) => (
              <GuideCard entry={entry} />
            ))}
          </div>
        ) : (
          <p class="text-muted">{t("guides.empty")}</p>
        )}
      </section>
    )
  }
</BaseLayout>
